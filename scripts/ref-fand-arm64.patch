diff --git a/tools/build.sh b/tools/build.sh
index 4ce6445..0f6fd1b 100755
--- a/tools/build.sh
+++ b/tools/build.sh
@@ -3,11 +3,16 @@
 set -euo pipefail
 repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
 cd "$repo_root/pas"
+rm -f FAND   # a failed compile must not leave the old binary
 fpc -Mtp -B "$@" FAND.PAS | grep -E "Error|Fatal|lines compiled" || true
 [[ -x FAND ]] || { echo "build.sh: compile failed" >&2; exit 1; }
 mkdir -p "$repo_root/bin"
 rm -f "$repo_root/bin/fand"   # a new inode: macOS kills an overwritten signed binary
 cp FAND "$repo_root/bin/fand"
 cp "$repo_root/fandres/FAND.RES" "$repo_root/fandcfg/FAND.CFG" "$repo_root/bin/"
-(cd "$repo_root/examples/hello" && "$repo_root/bin/fand" hello --source-in src </dev/null) \
-  || { echo "build.sh: examples/hello does not build" >&2; exit 1; }
+# the catalogue keeps paths in 79 chars: build the sample in a short temp dir
+hello_dir="$(mktemp -d /tmp/fandhello.XXXXXX)"
+cp -R "$repo_root/examples/hello/src" "$hello_dir/"
+(cd "$hello_dir" && "$repo_root/bin/fand" hello --source-in src </dev/null) \
+  || { echo "build.sh: examples/hello does not build" >&2; rm -rf "$hello_dir"; exit 1; }
+rm -rf "$hello_dir"
