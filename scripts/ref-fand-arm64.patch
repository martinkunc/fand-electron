+{$ifdef UNIX}
+{ DOS names are case-insensitive: each path component takes the case found on
+  disk (a catalogue's (STAN) directory is (stan)); a missing one is kept as is }
+function CasePath(const P:string):string;
+var i,j:integer; res,comp:string; sr:SysUtils.TSearchRec;
+begin
+  CasePath:=P; if (P='') or FileExists(P) or DirectoryExists(P) then exit;
+  res:=''; i:=1; if P[1]='/' then begin res:='/'; i:=2 end;
+  while i<=length(P) do begin
+    j:=i; while (j<=length(P)) and (P[j]<>'/') do inc(j);
+    comp:=copy(P,i,j-i);
+    if (comp<>'') and (comp<>'.') and (comp<>'..') and
+       not FileExists(res+comp) and not DirectoryExists(res+comp) then begin
+      if SysUtils.FindFirst(res+'*',faAnyFile or faDirectory,sr)=0 then begin
+        repeat
+          if SameText(sr.Name,comp) then begin comp:=sr.Name; break end
+        until SysUtils.FindNext(sr)<>0;
+        SysUtils.FindClose(sr) end end;
+    res:=res+comp; if j<=length(P) then res:=res+'/';
+    i:=j+1 end;
+  CasePath:=res;
+end;
+{$endif}
